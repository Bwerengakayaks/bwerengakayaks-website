# Copy to .env.local (Codespaces: use Codespaces Secrets or .env.local). Never commit real keys.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com
# Analytics / CRM scripts (only loaded after the visitor accepts cookies)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_HUBSPOT_ID=
# HubSpot private app token (server only) with crm.objects.contacts.write
HUBSPOT_TOKEN=
# Checkfront: your account address (no https://) and the item ID of each activity
NEXT_PUBLIC_CHECKFRONT_HOST=
NEXT_PUBLIC_CF_SUNRISE=
NEXT_PUBLIC_CF_SUNSET=
NEXT_PUBLIC_CF_FAMILY=
NEXT_PUBLIC_CF_FISHING=
# Pesapal payment page for Ugandan cards and Mobile Money (international card payments run inside Checkfront using Stripe)
NEXT_PUBLIC_PESAPAL_URL=
